
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id                    String   @id @default(uuid())
  portfolioId           String
  reviewerId            String
  problemUnderstanding  Int
  solutionQuality       Int
  execution             Int
  communication         Int
  totalScore            Int
  feedback              String   @db.VarChar(5000)
  createdAt             DateTime @default(now())

  // Một reviewer chỉ được review một portfolio một lần.
  @@unique([reviewerId, portfolioId])
  @@index([portfolioId, createdAt])
}
